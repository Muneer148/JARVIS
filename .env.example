# Copy these values into your local environment. NEVER commit a real API key.

# Local brain
JARVIS_OLLAMA_URL=http://localhost:11434/api/chat
JARVIS_MODEL=qwen3:8b

# Model router mode:
# auto = local first; selected complex tasks may escalate through an enabled gateway
# local = Ollama only
# nvidia = direct NVIDIA endpoint
# openrouter = direct OpenRouter endpoint
# omniroute = local OmniRoute gateway
JARVIS_BRAIN_MODE=auto

# NVIDIA hosted inference
NVIDIA_API_KEY=
JARVIS_NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
JARVIS_NVIDIA_URL=https://integrate.api.nvidia.com/v1/chat/completions

# OpenRouter direct gateway
OPENROUTER_API_KEY=
JARVIS_OPENROUTER_MODEL=openai/gpt-5
JARVIS_OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions

# OmniRoute local OpenAI-compatible gateway
# OmniRoute defaults to http://localhost:20128/v1 and requires a local API key.
# Generate/configure the key in OmniRoute; never commit it to Git.
JARVIS_OMNIROUTE_ENABLED=false
OMNIROUTE_API_KEY=
OMNIROUTE_BASE_URL=http://localhost:20128/v1
JARVIS_OMNIROUTE_MODEL=auto
JARVIS_OMNIROUTE_URL=http://localhost:20128/v1/chat/completions

JARVIS_DOWNLOADS_DIR=~/Downloads
JARVIS_TERMINAL_ENABLED=false
JARVIS_REQUEST_TIMEOUT=180
JARVIS_MAX_TOOL_ROUNDS=5
